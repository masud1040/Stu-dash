rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.email == 'saifulalammasudmn@gmail.com';
    }

    function isOwner(userEmail) {
      return isAuthenticated() && (request.auth.token.email == userEmail || isSuperAdmin());
    }

    // User data documents (milestones, notes, habits, todos, etc.)
    match /user_data/{userEmail} {
      allow read, write: if isOwner(userEmail);
    }

    // User profile records
    match /users/{userId} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid == userId ||
        request.auth.token.email == userId ||
        isSuperAdmin()
      );
    }

    // Admin & system metadata
    match /admin_metadata/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // Connection ping test document
    match /_connection_test/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Catch-all Super Admin access
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}


